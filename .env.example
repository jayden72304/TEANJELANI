DATABASE_URL="file:./prisma/dev.db"

# Generate a strong secret with: openssl rand -base64 32
SESSION_SECRET="replace-me-with-a-random-32-byte-secret"

# Shared secret an external scheduler (cron) sends as "Authorization: Bearer <value>"
# to POST /api/ingest and trigger a monitoring scan. Generate with: openssl rand -base64 32
INGEST_SECRET="replace-me-with-a-random-32-byte-secret"

# Optional — override the seeded admin login (see prisma/seed.ts). Defaults to
# agent@example.com / ChangeMe123! if unset.
# SEED_ADMIN_EMAIL="you@example.com"
# SEED_ADMIN_PASSWORD="a-strong-password"
